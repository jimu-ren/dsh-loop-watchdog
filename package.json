{
  "name": "dsh-loop-watchdog",
  "version": "1.0.0",
  "description": "DeepSeek Harness host plugin: detect long no-output (dead-loop) turns and auto-break them so the agent keeps thinking until the task is done.",
  "keywords": [
    "deepseek",
    "dsh",
    "harness",
    "plugin",
    "watchdog",
    "agent",
    "dead-loop"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
